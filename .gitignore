# ─── Secrets — NEVER commit ───────────────────────────────────────────────────
*.local.json
# atomic-write temps for any *.local.json (write-to-tmp-then-rename): the
# `*.local.json` rule above does NOT match a `.local.json.tmp-<pid>-<ts>` suffix,
# so cover every such temp here (relay-secret, promo-refresh-state, …).
*.local.json.tmp-*
bo-sites.json
data/bo-sites-runtime.json
data/relay-secret.local.json
data/relay-secret.local.json.tmp-*
google-credentials.local.json
# admitted-users.json is NOT a secret — it's a list of allow-listed Google
# emails managed via git so allowlist edits auto-deploy through Bitbucket.
# admitted-users.overlay.json IS server-local — the Manage Users screen writes it
# so in-UI edits persist across deploys (the deploy rewrites the git base). Never commit.
admitted-users.overlay.json

# ─── Runtime artifacts ────────────────────────────────────────────────────────
.session/
captures/
logs/
tmp/
tmp-plans/
tmp-runs/
output/
outputs/
canary-input.tmp
debug-*.html
debug-*.txt
debug-*.png
*.log
*.tmp

# ─── Large dev-only data files ────────────────────────────────────────────────
ft-api-calls-ws1.json

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
__MACOSX/
Thumbs.db
Desktop.ini
Banner/

# FastTrack browser relay temp files
tmp-ft-browser-pull*.json

# Promo report — per-brand player PII, served only by the authed promo host
data/promo/*/players/
# Runtime brand-viewer grants added via Manage Users (self-service; survives deploys)
data/promo/promo-brands.overlay.json
# Refresh button (D2): the worker-published live overlay + its atomic-write temps.
# serveReport prefers it over the committed report.json; it carries live data and
# must survive the in-place deploy git-pull without ever being committed.
data/promo/*/report.live.json
data/promo/*/report.live.json.tmp-*
# Store A — the nightly money rollup for the instant Brands-overview; shipped via the relay, rebuilt nightly
data/promo/*/store_a.json
data/promo/*/store_a.json.tmp-*
